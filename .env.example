# SMD2026 ticket-sale tracking (Stripe -> HubSpot). See SMD2026-SETUP.md
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
HUBSPOT_TOKEN=pat-eu1-xxx
# optional: numeric id of the SMD2026 static list
SMD2026_LIST_ID=761          # SMD2026 static list (already created)
# optional overrides if Stripe payment links change
SMD2026_PLINK_BASIC=
SMD2026_PLINK_BUSINESS=
SMD2026_PLINK_FIRSTCLASS=

# Lead magnet emails (Resend)
RESEND_API_KEY=re_xxx
LEITFADEN_LIST_ID=793
NOTIFY_FROM="Sales Mastery Days <noreply@sh-wachstum.de>"
NOTIFY_TO=info@sh-wachstum.de,info@tylotech.de

# Cloudflare Turnstile (bot check on the /send-code endpoint).
# Leave unset for local dev — the code falls back to Cloudflare's test keys
# that always pass. Real keys enable bot protection in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Twilio Verify (SMS one-time-code on the leitfaden form).
# Console → Verify → Services → create a service, then copy its VA… SID.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

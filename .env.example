# SMD2026 ticket-sale tracking (Stripe -> HubSpot). See SMD2026-SETUP.md
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
HUBSPOT_TOKEN=pat-eu1-xxx
# optional: numeric id of the SMD2026 static list
SMD2026_LIST_ID=761          # SMD2026 static list (already created)
# optional overrides if Stripe payment links change
SMD2026_PLINK_BASIC=
SMD2026_PLINK_BUSINESS=
SMD2026_PLINK_FIRSTCLASS=

# Lead magnet emails (Resend)
RESEND_API_KEY=re_xxx
LEITFADEN_LIST_ID=793
NOTIFY_FROM="Sales Mastery Days <noreply@sh-wachstum.de>"
NOTIFY_TO=info@sh-wachstum.de,info@tylotech.de

# Site-wide Kontaktformular → HubSpot segment list.
# Create a static list in HubSpot (e.g. "Kontaktformular Website"), copy
# its numeric id from the list URL and set it here. Without this the
# contact is still upserted, just not tagged into a list.
KONTAKT_HUBSPOT_LIST_ID=

# Handwerker-Painpoints Kampagne (/lp/handwerker-painpoints) → dedicated
# HubSpot segment list "Handwerk Erstgespräch – Potenzialanalyse".
# Create the static list in HubSpot, copy the numeric id from its URL
# and set it here. Without this the contact is upserted with the
# lead_magnet tag but not added to the segment.
HANDWERKER_PAINPOINTS_LIST_ID=

# SMS-verified-but-form-not-submitted capture (/api/phone/verify-only).
# When a visitor's Twilio SMS code is approved we upsert the contact by
# phone even if they never click Submit. If you want those abandoners
# routed into their own HubSpot list too, create a static list (e.g.
# "SMS verifiziert – Formular nicht abgeschickt"), copy the numeric id
# from the list URL and set it here. Optional — the contact is still
# upserted with lead_source="SMS-Verifizierung (Abbruch)" without it.
SMS_VERIFIED_HUBSPOT_LIST_ID=

# Meta Conversions API (server-side Lead event, complements the browser
# Meta Pixel). Optional — the pixel Lead event fires without this. Set
# both to enable server-side deduplication for iOS / ad-blocker traffic.
#   Business Manager → Events Manager → your pixel → Settings →
#   Conversions API → Generate access token.
META_PIXEL_ID=1677666316641507
META_CAPI_ACCESS_TOKEN=

# Meta Instant Forms → HubSpot bridge (/api/meta/lead-webhook).
# All three are needed for the bridge to work:
#   META_WEBHOOK_VERIFY_TOKEN
#     Random shared string used only during Meta's subscription
#     handshake. Any string is fine — must match what you paste
#     into Meta Business Manager → Webhooks. Generate with:
#       openssl rand -hex 32
#   META_APP_SECRET
#     Your Meta App's App Secret. Used to verify Meta's HMAC
#     signature on every incoming webhook so nothing spoofed reaches
#     HubSpot. Find it: developers.facebook.com → your App → Settings →
#     Basic → App Secret → Show.
#   META_PAGE_TOKEN
#     Long-lived Page access token for Selmir's Facebook Page — needed
#     to fetch the lead's field values via Graph API. Required scopes:
#     leads_retrieval, pages_show_list, pages_read_engagement.
#     Generate: Graph API Explorer → select the Page → generate token,
#     then extend to long-lived via oauth/access_token endpoint.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=

# Google Sheet append (Apps Script /exec webhook).
# - LEITFADEN_SHEET_WEBHOOK_URL: sheet for /leitfaden downloads
#     (deploy the script at scripts/leitfaden-sheet.gs to the sheet at
#      https://docs.google.com/spreadsheets/d/1jBsRniEI3_voHYr_u2dToupdRg4zwZupbNWOiXjDyto/)
# - GOOGLE_SHEET_WEBHOOK_URL: fallback (potenzialanalyse sheet).
LEITFADEN_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_URL=

# Cloudflare Turnstile (bot check on the /send-code endpoint).
# Leave unset for local dev — the code falls back to Cloudflare's test keys
# that always pass. Real keys enable bot protection in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Twilio Verify (SMS one-time-code on the leitfaden form).
# Console → Verify → Services → create a service, then copy its VA… SID.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret for the `sh_pv` cookie that skips SMS re-verification for
# returning visitors. Min 24 chars. Rotate to invalidate every cookie.
#   openssl rand -hex 32
PHONE_VERIFY_SECRET=
